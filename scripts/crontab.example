# ==============================================================================
# Sharegy Production Crontab Configuration (/etc/cron.d/sharegy)
# ==============================================================================
# ARCHITEKTUR-HINWEIS:
#  - MAILTO ist leer (""), da alle Skripte Fehler automatisch über den
#    smartEvo Incident-Hub (moniy) eskalieren und dort Tickets erstellen.
#  - Alle Ausgaben fließen sauber mit Zeitstempel nach /var/log/sharegy/*.log.
# ==============================================================================

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
MAILTO=""

# ------------------------------------------------------------------------------
# 1. 5-Minuten In-Flight Delta Database Backup Streamer
#    Streamt Live-Deltas komprimiert direkt an das smartEvo moniy Vault.
# ------------------------------------------------------------------------------
*/5 * * * * root {{APP_DIR}}/scripts/backup_postgres_inflight.sh >/dev/null 2>&1

# ------------------------------------------------------------------------------
# 2. High-Availability Watchdog & smartEvo Heartbeat (alle 2 Min)
#    Prüft Gunicorn, Daphne, PostgreSQL, Redis & MQTT; heilt bei Ausfall.
# ------------------------------------------------------------------------------
*/2 * * * * root {{APP_DIR}}/scripts/heartbeat_watchdog.sh >/dev/null 2>&1

# ------------------------------------------------------------------------------
# 3. Full PostgreSQL & TimescaleDB Backup (täglich um 03:00)
#    Erstellt Custom-Dump (-Fc) & .sql.gz inkl. S2S-Stream an moniy (7 Tage Retention).
# ------------------------------------------------------------------------------
0 3 * * * root {{APP_DIR}}/scripts/backup_db.sh >/dev/null 2>&1

# ------------------------------------------------------------------------------
# 4. Let's Encrypt / SSL Certificate Auto-Renewal & Expiry Check (2x täglich)
#    Führt certbot renew mit Nginx-Reload-Hook aus und prüft Restlaufzeit.
# ------------------------------------------------------------------------------
30 2,14 * * * root {{APP_DIR}}/scripts/renew_ssl.sh >/dev/null 2>&1

# ------------------------------------------------------------------------------
# 5. System Housekeeping: Expired Sessions & Tokens Cleanup (täglich um 04:00)
#    Bereinigt abgelaufene Django Sessions, Magic-Login-Tokens und temporäre Caches.
# ------------------------------------------------------------------------------
0 4 * * * root {{APP_DIR}}/scripts/cleanup_housekeeping.sh >/dev/null 2>&1

# ------------------------------------------------------------------------------
# 6. Log Rotation, Compression & Disk Space Guard (täglich um 04:30)
#    Komprimiert alte Logs (.gz), bereinigt nach 14 Tagen und öffnet moniy-Ticket bei > 85% Disk.
# ------------------------------------------------------------------------------
30 4 * * * root {{APP_DIR}}/scripts/rotate_logs.sh >/dev/null 2>&1
