---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "smartEvo | Business re-defined · Solarenergie, Sharegy & Factofy",
  description = "smartEvo GmbH – Ihr Partner für Photovoltaik-Komplettanlagen, intelligente HEMS-Technologie (Sharegy), faktenbasierte Datenanalyse (Factofy) und KRITIS-Beratung.",
} = Astro.props;
---

<!doctype html>
<html lang="de" class="bg-[#062F32] text-slate-900 antialiased selection:bg-[#1CC5D9] selection:text-[#062F32]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⚡</text></svg>" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="smartEvo GmbH" />

    <!-- Google Fonts: Poppins & Work Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,400;0,600;0,700;0,800;1,400&family=Work+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 text-slate-800 font-['Work_Sans']">
    <Navbar />
    
    <main class="flex-grow">
      <slot />
    </main>

    <Footer />
  </body>
</html>
