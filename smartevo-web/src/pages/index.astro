---
import Layout from '../layouts/Layout.astro';
import SolarCalculator from '../components/SolarCalculator.astro';
---

<Layout
  title="smartEvo | Business re-defined · Photovoltaik, Sharegy HEMS & Factofy"
  description="smartEvo GmbH – Premium-Lösungen für Dekarbonisierung, maßgeschneiderte Photovoltaik-Anlagen, intelligentes HEMS (Sharegy), faktenbasierte Datenplattformen (Factofy) und KRITIS-Beratung."
>

  <!-- ========================================================================= -->
  <!-- 1. HERO BANNER SECTION -->
  <!-- ========================================================================= -->
  <section class="relative bg-gradient-to-b from-[#062F32] via-[#042022] to-[#062F32] text-white py-24 md:py-32 overflow-hidden border-b border-white/10">
    <!-- Background Elements -->
    <div class="absolute inset-0 opacity-20 bg-[radial-gradient(#1CC5D9_1px,transparent_1px)] [background-size:24px_24px] pointer-events-none"></div>
    <div class="absolute top-1/4 -right-32 w-96 h-96 bg-[#1CC5D9]/20 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-10 -left-32 w-96 h-96 bg-emerald-500/15 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center max-w-4xl mx-auto space-y-6">
        
        <!-- Top Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-widest bg-[#1CC5D9]/15 text-[#1CC5D9] border border-[#1CC5D9]/30">
          ⚡ Business re-defined · Dekarbonisierung & Faktenbasierte Transformation
        </div>

        <!-- Main H1 Headline -->
        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold text-white tracking-tight leading-tight font-['Poppins']">
          Die Zukunft der Energie <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#1CC5D9] via-teal-300 to-emerald-400">
            verstehen, steuern & nutzen.
          </span>
        </h1>

        <!-- Subtitle -->
        <p class="text-lg sm:text-xl text-slate-300 max-w-2xl mx-auto font-light leading-relaxed">
          Premium-Photovoltaik mit integriertem <strong class="text-white font-semibold">Sharegy HEMS</strong>, faktenbasierte Datenanalysen mit <strong class="text-white font-semibold">Factofy</strong> und strategische KRITIS-Absicherung für zukunftssichere Unternehmen und Kommunen.
        </p>

        <!-- CTA Buttons Duo -->
        <div class="pt-6 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="/solarenergie"
            class="w-full sm:w-auto px-8 py-4 rounded-xl bg-[#1CC5D9] text-[#062F32] font-black text-base hover:bg-[#17AEC0] shadow-xl hover:shadow-[#1CC5D9]/30 hover:scale-105 transition-all flex items-center justify-center gap-2.5 font-['Poppins']"
          >
            <span>☀️ PV-Anlagen & Speicher entdecken</span>
            <span class="text-xl">→</span>
          </a>
          
          <a
            href="https://sharegy.de"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-7 py-4 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold text-base border border-white/20 backdrop-blur-sm transition-all flex items-center justify-center gap-2"
          >
            <span>⚡ Sharegy Plattform</span>
            <span class="text-xs text-slate-400">↗</span>
          </a>
          
          <a
            href="https://factofy.io"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-7 py-4 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold text-base border border-white/20 backdrop-blur-sm transition-all flex items-center justify-center gap-2"
          >
            <span>📊 Factofy Cockpit</span>
            <span class="text-xs text-slate-400">↗</span>
          </a>
        </div>

        <!-- Trust Badges Bar -->
        <div class="pt-12 grid grid-cols-2 sm:grid-cols-4 gap-4 text-center border-t border-white/10 max-w-3xl mx-auto text-xs text-slate-400">
          <div>✅ <b>Tier-1 Solarmodule</b> & Speicher</div>
          <div>✅ <b>Sharegy HEMS</b> out-of-the-box</div>
          <div>✅ <b>§ 14a EnWG</b> konform</div>
          <div>✅ <b>KRITIS & ISO 37120</b> zertifiziert</div>
        </div>

      </div>
    </div>
  </section>


  <!-- ========================================================================= -->
  <!-- 2. 3-SÄULEN MATRIX: "NUR DAS BESTE FÜR IHREN ERFOLG" -->
  <!-- ========================================================================= -->
  <section class="py-20 bg-slate-50 text-slate-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs font-bold uppercase tracking-widest text-[#062F32] bg-[#1CC5D9]/20 px-3 py-1 rounded-full border border-[#1CC5D9]/40">
          Das smartEvo Ökosystem
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-[#062F32] mt-3 font-['Poppins']">
          Ganzheitliche Lösungen für Energie, Daten & Infrastruktur
        </h2>
        <p class="text-slate-600 mt-3 text-base">
          Drei spezialisierte Säulen für maximale Unabhängigkeit, Wirtschaftlichkeit und Sicherheit.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- Card 1: Solarenergie & Sharegy -->
        <div class="bg-white rounded-2xl p-8 border border-slate-200 shadow-lg hover:shadow-xl hover:-translate-y-1 transition-all flex flex-col justify-between group">
          <div>
            <div class="w-14 h-14 rounded-2xl bg-[#062F32] text-[#1CC5D9] flex items-center justify-center text-2xl font-black mb-6 group-hover:scale-110 transition-transform">
              ☀️
            </div>
            <div class="text-xs font-bold uppercase tracking-wider text-amber-600 mb-1">
              Photovoltaik & HEMS
            </div>
            <h3 class="text-2xl font-bold text-[#062F32] mb-3 font-['Poppins']">
              Solarenergie & Sharegy
            </h3>
            <p class="text-slate-600 text-sm leading-relaxed mb-6">
              Maßgeschneiderte PV-Komplettanlagen, Batteriespeicher und Wallboxen – serienmäßig ausgestattet mit dem intelligenten <strong class="text-slate-900">Sharegy HEMS</strong> für dynamische Börsenstromtarife und maximalen Eigenverbrauch.
            </p>
            <ul class="space-y-2 text-xs text-slate-700 font-medium mb-6">
              <li class="flex items-center gap-2"><span>✅</span> Bis zu 85 % Autarkiegrad</li>
              <li class="flex items-center gap-2"><span>✅</span> PV-Überschussladen & Wärmepumpe</li>
              <li class="flex items-center gap-2"><span>✅</span> Dezentrales Energy-Sharing & Mieterstrom</li>
            </ul>
          </div>
          <a
            href="/solarenergie"
            class="inline-flex items-center justify-between px-5 py-3 rounded-xl bg-[#062F32] text-[#1CC5D9] font-bold text-sm hover:bg-[#042022] transition-colors"
          >
            <span>PV-Anlagen entdecken</span>
            <span>→</span>
          </a>
        </div>

        <!-- Card 2: Factofy Monitoring -->
        <div class="bg-white rounded-2xl p-8 border border-slate-200 shadow-lg hover:shadow-xl hover:-translate-y-1 transition-all flex flex-col justify-between group">
          <div>
            <div class="w-14 h-14 rounded-2xl bg-blue-900 text-blue-300 flex items-center justify-center text-2xl font-black mb-6 group-hover:scale-110 transition-transform">
              📊
            </div>
            <div class="text-xs font-bold uppercase tracking-wider text-blue-600 mb-1">
              B2B-Monitoring & Audits
            </div>
            <h3 class="text-2xl font-bold text-slate-900 mb-3 font-['Poppins']">
              Factofy Cockpit
            </h3>
            <p class="text-slate-600 text-sm leading-relaxed mb-6">
              Die faktenbasierte Daten- und Entscheidungsplattform. Vereint heterogene IoT-Sensoren, Zählerdaten und Maschinenparameter in einem zentralen Managementsystem inklusive automatisierter Trendprognosen.
            </p>
            <ul class="space-y-2 text-xs text-slate-700 font-medium mb-6">
              <li class="flex items-center gap-2"><span>✅</span> Echtzeit-Visualisierung & OEE-KPIs</li>
              <li class="flex items-center gap-2"><span>✅</span> Automatische Audit- & Compliance-Reports</li>
              <li class="flex items-center gap-2"><span>✅</span> Nahtlose API- & Gateway-Anbindung</li>
            </ul>
          </div>
          <a
            href="https://factofy.io"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-between px-5 py-3 rounded-xl bg-blue-900 text-blue-200 font-bold text-sm hover:bg-blue-950 transition-colors"
          >
            <span>Factofy kennenlernen</span>
            <span>↗</span>
          </a>
        </div>

        <!-- Card 3: KRITIS & Smart City Consulting -->
        <div class="bg-white rounded-2xl p-8 border border-slate-200 shadow-lg hover:shadow-xl hover:-translate-y-1 transition-all flex flex-col justify-between group">
          <div>
            <div class="w-14 h-14 rounded-2xl bg-slate-900 text-slate-200 flex items-center justify-center text-2xl font-black mb-6 group-hover:scale-110 transition-transform">
              🔒
            </div>
            <div class="text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">
              Consulting & IT-Sicherheit
            </div>
            <h3 class="text-2xl font-bold text-slate-900 mb-3 font-['Poppins']">
              KRITIS & Smart City
            </h3>
            <p class="text-slate-600 text-sm leading-relaxed mb-6">
              Ganzheitliche Beratung und Zertifizierung für Betreiber kritischer Infrastrukturen nach IT-Sicherheitsgesetz sowie datenbasierte Stadt- und Quartiersentwicklung nach der internationalen ISO-Norm 37120.
            </p>
            <ul class="space-y-2 text-xs text-slate-700 font-medium mb-6">
              <li class="flex items-center gap-2"><span>✅</span> KRITIS-Audits & § 8a BSIG Compliance</li>
              <li class="flex items-center gap-2"><span>✅</span> ISO 37120 Nachhaltigkeitsindikatoren</li>
              <li class="flex items-center gap-2"><span>✅</span> Kommunale Wärme- & Quartierskonzepte</li>
            </ul>
          </div>
          <a
            href="/dienstleistungen/kritische-infrastrukturen"
            class="inline-flex items-center justify-between px-5 py-3 rounded-xl bg-slate-900 text-slate-200 font-bold text-sm hover:bg-slate-950 transition-colors"
          >
            <span>Beratungsangebote</span>
            <span>→</span>
          </a>
        </div>

      </div>

    </div>
  </section>


  <!-- ========================================================================= -->
  <!-- 3. INTERAKTIVER PV-RECHNER SECTION -->
  <!-- ========================================================================= -->
  <section class="py-16 bg-[#042022] border-y border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SolarCalculator />
    </div>
  </section>


  <!-- ========================================================================= -->
  <!-- 4. SPOTLIGHT: SHAREGY HEMS & DYNAMISCHE TARIFE -->
  <!-- ========================================================================= -->
  <section class="py-20 bg-[#062F32] text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-6 space-y-6">
          <span class="text-xs font-bold uppercase tracking-widest text-[#1CC5D9] bg-[#1CC5D9]/20 px-3 py-1 rounded-full border border-[#1CC5D9]/40">
            ⚡ Intelligentes Energiemanagement
          </span>
          <h2 class="text-3xl sm:text-4xl font-extrabold font-['Poppins']">
            Sharegy – Ihr Energiemanager für die Hosentasche
          </h2>
          <p class="text-slate-300 text-base leading-relaxed">
            Erhöhen Sie den Nutzen Ihrer PV-Anlage dramatisch: Sharegy prognostiziert Ihren Solarertrag 96 Stunden im Voraus, steuert Ihren Batteriespeicher bei negativen Börsenstrompreisen und lädt Ihr E-Auto dann, wenn der Strom am günstigsten ist.
          </p>

          <div class="grid grid-cols-2 gap-4 pt-2">
            <div class="bg-white/5 p-4 rounded-xl border border-white/10">
              <div class="text-xl font-bold text-[#1CC5D9] mb-1">📈 EPEX-Spot</div>
              <p class="text-xs text-slate-300">Automatisches Laden bei Tiefpreisen an der Strombörse.</p>
            </div>
            <div class="bg-white/5 p-4 rounded-xl border border-white/10">
              <div class="text-xl font-bold text-[#1CC5D9] mb-1">🚗 PV-Boost</div>
              <p class="text-xs text-slate-300">Wallbox-Steuerung mit 100 % reinem Solarstrom.</p>
            </div>
          </div>

          <div class="pt-4">
            <a
              href="https://sharegy.de"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-[#1CC5D9] text-[#062F32] font-black text-sm hover:bg-[#17AEC0] transition-colors"
            >
              <span>Mehr über Sharegy erfahren</span>
              <span>↗</span>
            </a>
          </div>
        </div>

        <div class="lg:col-span-6 bg-gradient-to-tr from-[#042022] to-[#0A484D] p-8 rounded-3xl border border-[#1CC5D9]/30 shadow-2xl space-y-4">
          <div class="flex items-center justify-between border-b border-white/10 pb-4">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-emerald-400 animate-ping"></span>
              <span class="font-mono text-xs font-bold text-emerald-400">LIVE EMS FLOW</span>
            </div>
            <span class="text-xs text-slate-400 font-mono">Autarkie: 92 %</span>
          </div>

          <!-- Mini Mockup Live Grid -->
          <div class="grid grid-cols-2 gap-3 text-center">
            <div class="bg-amber-500/10 border border-amber-500/30 p-4 rounded-xl">
              <div class="text-xs text-amber-300 font-bold">☀️ PV-ERZEUGUNG</div>
              <div class="text-2xl font-black text-amber-400 font-mono mt-1">8,4 kW</div>
            </div>
            <div class="bg-emerald-500/10 border border-emerald-500/30 p-4 rounded-xl">
              <div class="text-xs text-emerald-300 font-bold">🔋 SPEICHER (LADEN)</div>
              <div class="text-2xl font-black text-emerald-400 font-mono mt-1">3,2 kW (78%)</div>
            </div>
            <div class="bg-blue-500/10 border border-blue-500/30 p-4 rounded-xl">
              <div class="text-xs text-blue-300 font-bold">🚗 WALLBOX</div>
              <div class="text-2xl font-black text-blue-400 font-mono mt-1">4,1 kW (Solar)</div>
            </div>
            <div class="bg-purple-500/10 border border-purple-500/30 p-4 rounded-xl">
              <div class="text-xs text-purple-300 font-bold">⚡ NETZBEZUG</div>
              <div class="text-2xl font-black text-purple-300 font-mono mt-1">0,0 kW</div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- ========================================================================= -->
  <!-- 5. CALL TO ACTION / KONTAKT -->
  <!-- ========================================================================= -->
  <section class="py-20 bg-gradient-to-br from-[#042022] via-[#062F32] to-[#171717] text-white border-t border-white/10 text-center">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      <h2 class="text-3xl sm:text-5xl font-extrabold font-['Poppins'] tracking-tight">
        Bereit für die eigene <span class="text-[#1CC5D9]">Solar-Unabhängigkeit?</span>
      </h2>
      <p class="text-slate-300 text-base max-w-2xl mx-auto">
        Lassen Sie sich unverbindlich von unseren Experten beraten. Wir planen Ihre schlüsselfertige PV-Anlage inklusive Speicher und smarter Steuerung.
      </p>
      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/solarenergie#anfrage"
          class="px-8 py-4 rounded-xl bg-[#1CC5D9] text-[#062F32] font-black text-base hover:bg-[#17AEC0] shadow-xl hover:scale-105 transition-all font-['Poppins'] uppercase tracking-wider"
        >
          ☀️ Jetzt Angebot anfordern
        </a>
        <a
          href="/kontakt"
          class="px-7 py-4 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold text-base border border-white/20 transition-colors"
        >
          📞 Kontakt aufnehmen
        </a>
      </div>
    </div>
  </section>

</Layout>
