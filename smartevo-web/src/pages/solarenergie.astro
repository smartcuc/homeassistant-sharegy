---
import Layout from '../layouts/Layout.astro';
import SolarCalculator from '../components/SolarCalculator.astro';
---

<Layout
  title="Photovoltaik & Solaranlagen Komplett-Pakete | smartEvo"
  description="smartEvo Photovoltaik: Maßgeschneiderte PV-Komplettanlagen, Batteriespeicher & Wallboxen inklusive intelligentem Sharegy HEMS für maximalen Eigenverbrauch und dynamische Tarife."
>

  <!-- ========================================================================= -->
  <!-- 1. HERO SECTION -->
  <!-- ========================================================================= -->
  <section class="relative bg-gradient-to-b from-[#062F32] via-[#042022] to-[#062F32] text-white py-20 md:py-28 overflow-hidden border-b border-white/10">
    <div class="absolute inset-0 opacity-20 bg-[radial-gradient(#1CC5D9_1px,transparent_1px)] [background-size:24px_24px] pointer-events-none"></div>
    <div class="absolute top-1/3 -right-32 w-96 h-96 bg-[#1CC5D9]/20 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-400/20 text-amber-300 border border-amber-400/30">
            ☀️ Die Kraft der Sonne · Unabhängig & Zukunftssicher
          </div>

          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-tight font-['Poppins']">
            Ihre schlüsselfertige <br />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#1CC5D9] via-amber-300 to-emerald-400">
              PV-Anlage mit Speicher & HEMS
            </span>
          </h1>

          <p class="text-base sm:text-lg text-slate-300 font-light leading-relaxed">
            Nutzen Sie Ihren eigenen Sonnenstrom zu bis zu <strong class="text-white font-semibold">85 % autark</strong>: smartEvo plant, liefert und montiert hochwertige Photovoltaik-Komplettsysteme – serienmäßig ausgestattet mit dem intelligenten <strong class="text-[#1CC5D9] font-semibold">Sharegy HEMS</strong> für dynamische Börsenstromtarife und smarte Wallbox-Steuerung.
          </p>

          <div class="pt-4 flex flex-col sm:flex-row items-center gap-4">
            <a
              href="#anfrage"
              class="w-full sm:w-auto px-8 py-4 rounded-xl bg-[#1CC5D9] text-[#062F32] font-black text-base hover:bg-[#17AEC0] shadow-xl hover:scale-105 transition-all flex items-center justify-center gap-2 font-['Poppins'] uppercase tracking-wider"
            >
              <span>☀️ Kostenloses Angebot anfordern</span>
            </a>
            <a
              href="#pv-rechner"
              class="w-full sm:w-auto px-6 py-4 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold text-base border border-white/20 transition-colors flex items-center justify-center gap-2"
            >
              <span>🧮 Zum Ersparnisrechner</span>
            </a>
          </div>

          <!-- USPs Checklist -->
          <div class="grid grid-cols-2 gap-3 pt-6 border-t border-white/10 text-xs text-slate-300">
            <div class="flex items-center gap-2"><span>✅</span> <b>Tier-1 Glas-Glas</b> Module (30J Garantie)</div>
            <div class="flex items-center gap-2"><span>✅</span> <b>Sharegy HEMS</b> out-of-the-box</div>
            <div class="flex items-center gap-2"><span>✅</span> <b>§ 14a EnWG</b> Dimm-Schutz integriert</div>
            <div class="flex items-center gap-2"><span>✅</span> <b>Netzanmeldung & Montage</b> inklusive</div>
          </div>
        </div>

        <!-- Hero Card Graphic -->
        <div class="lg:col-span-5 bg-gradient-to-br from-[#062F32] to-[#042022] p-8 rounded-3xl border border-[#1CC5D9]/40 shadow-2xl space-y-6">
          <div class="text-center">
            <span class="text-xs font-bold uppercase tracking-wider text-[#1CC5D9]">smartEvo PV-Standard</span>
            <h3 class="text-2xl font-bold font-['Poppins'] text-white mt-1">Das All-in-One Energiesystem</h3>
          </div>

          <div class="space-y-3 text-sm">
            <div class="p-3.5 rounded-xl bg-white/5 border border-white/10 flex items-start gap-3">
              <span class="text-xl">☀️</span>
              <div>
                <div class="font-bold text-white">Tier-1 Full-Black Module</div>
                <div class="text-xs text-slate-400">Höchster Wirkungsgrad (> 22,5 %) auch bei diffusem Licht.</div>
              </div>
            </div>

            <div class="p-3.5 rounded-xl bg-white/5 border border-white/10 flex items-start gap-3">
              <span class="text-xl">🔋</span>
              <div>
                <div class="font-bold text-white">Modularer Batteriespeicher</div>
                <div class="text-xs text-slate-400">LFP-Technologie mit über 6.000 Ladezyklen & Notstrom-Option.</div>
              </div>
            </div>

            <div class="p-3.5 rounded-xl bg-white/5 border border-white/10 flex items-start gap-3">
              <span class="text-xl">⚡</span>
              <div>
                <div class="font-bold text-emerald-400">Sharegy HEMS & EPEX Börsentarife</div>
                <div class="text-xs text-slate-400">Lädt den Speicher bei billigem Börsenstrom und optimiert Wallbox & WP.</div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- ========================================================================= -->
  <!-- 2. INTERAKTIVER SOLAR-RECHNER -->
  <!-- ========================================================================= -->
  <section class="py-20 bg-slate-50 text-slate-900" id="pv-rechner">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SolarCalculator />
    </div>
  </section>


  <!-- ========================================================================= -->
  <!-- 3. DIE 3 SMARTEVO PV-PAKETE -->
  <!-- ========================================================================= -->
  <section class="py-20 bg-slate-100 border-y border-slate-200 text-slate-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs font-bold uppercase tracking-widest text-[#062F32] bg-[#1CC5D9]/20 px-3 py-1 rounded-full border border-[#1CC5D9]/40">
          Paket-Übersicht
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-[#062F32] mt-3 font-['Poppins']">
          Maßgeschneiderte Solarlösungen für jeden Bedarf
        </h2>
        <p class="text-slate-600 mt-2 text-base">
          Vom kompakten Einfamilienhaus bis hin zur Gewerbe- und Mehrfamilienhausanlage.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- Paket 1 -->
        <div class="bg-white rounded-2xl p-8 border border-slate-200 shadow-md hover:shadow-xl transition-all flex flex-col justify-between">
          <div>
            <div class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-1">Einstieg / Reihenhaus</div>
            <h3 class="text-2xl font-bold text-[#062F32] mb-2 font-['Poppins']">smartEvo Compact</h3>
            <div class="text-3xl font-black text-[#062F32] mb-4 font-mono">6 - 8 kWp</div>
            <p class="text-sm text-slate-600 mb-6 leading-relaxed">
              Ideal für kleinere Dachflächen und Jahresverbräuche bis 4.000 kWh.
            </p>
            <ul class="space-y-2.5 text-xs text-slate-700 font-medium border-t border-slate-100 pt-4 mb-6">
              <li class="flex items-center gap-2"><span>✅</span> 14–18 Glas-Glas Solarmodule</li>
              <li class="flex items-center gap-2"><span>✅</span> 5,0 kWh LFP-Batteriespeicher</li>
              <li class="flex items-center gap-2"><span>✅</span> Hybrid-Wechselrichter mit App</li>
              <li class="flex items-center gap-2"><span>✅</span> Sharegy HEMS Basis-Lizenz</li>
            </ul>
          </div>
          <a
            href="#anfrage"
            class="block text-center py-3 px-4 rounded-xl bg-slate-100 hover:bg-[#062F32] hover:text-[#1CC5D9] text-slate-800 font-bold text-sm transition-colors"
          >
            Paket anfragen →
          </a>
        </div>

        <!-- Paket 2 (Popular) -->
        <div class="bg-[#062F32] text-white rounded-2xl p-8 border-2 border-[#1CC5D9] shadow-2xl relative flex flex-col justify-between">
          <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-[#1CC5D9] text-[#062F32] text-xs font-black px-3.5 py-0.5 rounded-full uppercase tracking-wider">
            Beliebtestes Paket
          </div>
          <div>
            <div class="text-xs font-bold uppercase tracking-wider text-[#1CC5D9] mb-1">Einfamilienhaus / Familie</div>
            <h3 class="text-2xl font-bold text-white mb-2 font-['Poppins']">smartEvo Family Pro</h3>
            <div class="text-3xl font-black text-[#1CC5D9] mb-4 font-mono">10 - 15 kWp</div>
            <p class="text-sm text-slate-300 mb-6 leading-relaxed">
              Perfekt abgestimmt für Familien mit Wärmepumpe und Elektroauto. Bis zu 85 % Autarkie.
            </p>
            <ul class="space-y-2.5 text-xs text-slate-200 font-medium border-t border-white/10 pt-4 mb-6">
              <li class="flex items-center gap-2"><span>✅</span> 24–36 Full-Black Hochleistungsmodule</li>
              <li class="flex items-center gap-2"><span>✅</span> 10,0 kWh LFP-Speicher (erweiterbar)</li>
              <li class="flex items-center gap-2"><span>✅</span> 11 kW PV-Überschuss-Wallbox</li>
              <li class="flex items-center gap-2"><span>✅</span> Sharegy HEMS Pro & Börsentarif-Steuerung</li>
            </ul>
          </div>
          <a
            href="#anfrage"
            class="block text-center py-3.5 px-4 rounded-xl bg-[#1CC5D9] text-[#062F32] font-black text-sm hover:bg-[#17AEC0] transition-colors uppercase tracking-wider font-['Poppins']"
          >
            Family Pro anfragen →
          </a>
        </div>

        <!-- Paket 3 -->
        <div class="bg-white rounded-2xl p-8 border border-slate-200 shadow-md hover:shadow-xl transition-all flex flex-col justify-between">
          <div>
            <div class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-1">Gewerbe & Mehrfamilienhaus</div>
            <h3 class="text-2xl font-bold text-[#062F32] mb-2 font-['Poppins']">smartEvo Commercial</h3>
            <div class="text-3xl font-black text-[#062F32] mb-4 font-mono">20 - 100+ kWp</div>
            <p class="text-sm text-slate-600 mb-6 leading-relaxed">
              Für Gewerbebetriebe, Landwirtschaft, WEGs und Mieterstrom-Modelle nach § 42b EnWG.
            </p>
            <ul class="space-y-2.5 text-xs text-slate-700 font-medium border-t border-slate-100 pt-4 mb-6">
              <li class="flex items-center gap-2"><span>✅</span> Großdach-Module & Gewerbewechselrichter</li>
              <li class="flex items-center gap-2"><span>✅</span> Gewerbespeicher ab 20 bis 100+ kWh</li>
              <li class="flex items-center gap-2"><span>✅</span> Mieterstrom-Abrechnung & Lastspitzenkappung</li>
              <li class="flex items-center gap-2"><span>✅</span> Factofy & Sharegy Flotten-Cockpit</li>
            </ul>
          </div>
          <a
            href="#anfrage"
            class="block text-center py-3 px-4 rounded-xl bg-slate-100 hover:bg-[#062F32] hover:text-[#1CC5D9] text-slate-800 font-bold text-sm transition-colors"
          >
            Gewerbe-Angebot anfordern →
          </a>
        </div>

      </div>

    </div>
  </section>


  <!-- ========================================================================= -->
  <!-- 4. LEAD / ANGEBOTSFORMULAR -->
  <!-- ========================================================================= -->
  <section class="py-20 bg-[#062F32] text-white" id="anfrage">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="bg-white rounded-3xl p-8 sm:p-12 text-slate-900 shadow-2xl border border-slate-200">
        
        <div class="text-center max-w-xl mx-auto mb-8">
          <span class="text-xs font-bold uppercase tracking-wider text-[#062F32] bg-[#1CC5D9]/20 px-3 py-1 rounded-full border border-[#1CC5D9]/40">
            Unverbindliche Anfrage
          </span>
          <h2 class="text-3xl font-bold text-[#062F32] mt-3 font-['Poppins']">
            Ihr persönliches Solar-Angebot
          </h2>
          <p class="text-sm text-slate-600 mt-2">
            Füllen Sie einfach das Formular aus. Unsere Energie-Experten erstellen für Sie eine maßgeschneiderte Wirtschaftlichkeitsberechnung.
          </p>
        </div>

        <form class="space-y-6">
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold uppercase text-slate-700 mb-1">Objekt-Typ</label>
              <select class="w-full px-4 py-3 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-[#1CC5D9] focus:outline-none">
                <option>Einfamilienhaus</option>
                <option>Doppelhaushälfte / Reihenhaus</option>
                <option>Mehrfamilienhaus / WEG</option>
                <option>Gewerbebetrieb / Halle</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-bold uppercase text-slate-700 mb-1">Dachform</label>
              <select class="w-full px-4 py-3 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-[#1CC5D9] focus:outline-none">
                <option>Satteldach</option>
                <option>Flachdach</option>
                <option>Pultdach</option>
                <option>Walmdach</option>
              </select>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold uppercase text-slate-700 mb-1">Vorname & Nachname *</label>
              <input
                type="text"
                required
                placeholder="Max Mustermann"
                class="w-full px-4 py-3 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-[#1CC5D9] focus:outline-none"
              />
            </div>

            <div>
              <label class="block text-xs font-bold uppercase text-slate-700 mb-1">E-Mail-Adresse *</label>
              <input
                type="email"
                required
                placeholder="max@beispiel.de"
                class="w-full px-4 py-3 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-[#1CC5D9] focus:outline-none"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold uppercase text-slate-700 mb-1">Telefonnummer (für Rückfragen)</label>
              <input
                type="tel"
                placeholder="0170 1234567"
                class="w-full px-4 py-3 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-[#1CC5D9] focus:outline-none"
              />
            </div>

            <div>
              <label class="block text-xs font-bold uppercase text-slate-700 mb-1">PLZ & Ort *</label>
              <input
                type="text"
                required
                placeholder="46483 Wesel"
                class="w-full px-4 py-3 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-[#1CC5D9] focus:outline-none"
              />
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold uppercase text-slate-700 mb-1">Ihre Nachricht / Besonderheiten (optional)</label>
            <textarea
              rows="3"
              placeholder="z. B. Speicher gewünscht, E-Auto vorhanden, Wärmepumpe in Planung..."
              class="w-full px-4 py-3 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-[#1CC5D9] focus:outline-none"
            ></textarea>
          </div>

          <div class="pt-2">
            <button
              type="button"
              onclick="alert('Vielen Dank für Ihre Anfrage! Unser Team meldet sich in Kürze bei Ihnen.')"
              class="w-full py-4 rounded-xl bg-[#062F32] text-[#1CC5D9] font-black text-base hover:bg-[#042022] transition-all font-['Poppins'] uppercase tracking-wider shadow-lg cursor-pointer"
            >
              ☀️ Anfrage jetzt absenden
            </button>
            <p class="text-center text-[11px] text-slate-500 mt-3">
              Ihre Daten werden verschlüsselt übertragen und streng nach DSGVO verarbeitet.
            </p>
          </div>

        </form>

      </div>

    </div>
  </section>

</Layout>
