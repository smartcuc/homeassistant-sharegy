---
import Layout from "../layouts/Layout.astro";
---

<Layout 
  title="Kontakt | smartEvo GmbH"
  description="Treten Sie mit der smartEvo GmbH in Kontakt. Wir beraten Sie zu Photovoltaik, KRITIS, Smart City und unseren SaaS-Lösungen."
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-b from-[#062F32] to-[#0B4F54] text-white py-20 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#1CC5D9]/20 border border-[#1CC5D9]/30 text-[#1CC5D9] text-xs font-semibold uppercase tracking-wider mb-4">
        📬 Dialog auf Augenhöhe
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold font-['Poppins'] tracking-tight mb-4">
        Lassen Sie uns <span class="text-[#1CC5D9]">sprechen</span>
      </h1>
      <p class="text-lg text-slate-200 max-w-2xl mx-auto">
        Haben Sie Fragen zu unseren PV-Komplettanlagen, Sicherheitsberatung oder Plattformen? Schreiben Sie uns oder rufen Sie uns direkt an.
      </p>
    </div>
  </section>

  <!-- Content Section -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        
        <!-- Contact Info Cards (5 Cols) -->
        <div class="lg:col-span-5 space-y-6">
          <div class="bg-white rounded-2xl p-8 border border-slate-200/80 shadow-sm">
            <h2 class="text-2xl font-bold text-[#062F32] font-['Poppins'] mb-6">
              Kontaktdaten
            </h2>
            
            <div class="space-y-6">
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-xl bg-[#1CC5D9]/10 text-[#062F32] flex items-center justify-center text-xl flex-shrink-0">
                  🏢
                </div>
                <div>
                  <h3 class="text-sm font-bold text-[#062F32]">Unternehmenssitz</h3>
                  <p class="text-slate-600 text-sm mt-0.5">
                    smartEvo GmbH<br />
                    Klever-Tor-Platz 1<br />
                    46483 Wesel, Deutschland
                  </p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-xl bg-[#1CC5D9]/10 text-[#062F32] flex items-center justify-center text-xl flex-shrink-0">
                  ✉️
                </div>
                <div>
                  <h3 class="text-sm font-bold text-[#062F32]">E-Mail</h3>
                  <p class="text-slate-600 text-sm mt-0.5">
                    <a href="mailto:info@smartevo.de" class="text-[#1CC5D9] hover:underline font-medium">info@smartevo.de</a>
                  </p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-xl bg-[#1CC5D9]/10 text-[#062F32] flex items-center justify-center text-xl flex-shrink-0">
                  🌐
                </div>
                <div>
                  <h3 class="text-sm font-bold text-[#062F32]">Plattformen & Produkte</h3>
                  <p class="text-slate-600 text-sm mt-0.5 space-y-1">
                    <a href="https://sharegy.de" target="_blank" class="block text-slate-700 hover:text-[#1CC5D9] font-medium">⚡ sharegy.de (Energy Sharing & EMS)</a>
                    <a href="https://factofy.io" target="_blank" class="block text-slate-700 hover:text-[#1CC5D9] font-medium">📊 factofy.io (Business Intelligence)</a>
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Highlight Box for Solar -->
          <div class="bg-gradient-to-br from-[#062F32] to-[#0A474D] rounded-2xl p-6 text-white shadow-sm border border-white/10">
            <h3 class="text-lg font-bold text-amber-300 flex items-center gap-2 mb-2">
              ☀️ Interesse an einer Solaranlage?
            </h3>
            <p class="text-sm text-slate-200 mb-4 leading-relaxed">
              Nutzen Sie unseren kostenlosen Solar-Ertragsrechner und erhalten Sie innerhalb von 24h ein maßgeschneidertes Komplettangebot inklusive Speicher und Sharegy HEMS.
            </p>
            <a
              href="/solarenergie#anfrage"
              class="inline-block px-5 py-2.5 rounded-lg bg-[#1CC5D9] text-[#062F32] text-sm font-bold hover:bg-[#17AEC0] transition-colors"
            >
              Zum Solar-Konfigurator →
            </a>
          </div>
        </div>

        <!-- Contact Form (7 Cols) -->
        <div class="lg:col-span-7">
          <div class="bg-white rounded-2xl p-8 sm:p-10 border border-slate-200/80 shadow-sm">
            <h2 class="text-2xl font-bold text-[#062F32] font-['Poppins'] mb-2">
              Nachricht senden
            </h2>
            <p class="text-slate-600 text-sm mb-8">
              Füllen Sie das Formular aus – wir melden uns zeitnah bei Ihnen.
            </p>

            <form action="mailto:info@smartevo.de" method="post" enctype="text/plain" class="space-y-6">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                  <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                    Vor- und Nachname *
                  </label>
                  <input
                    type="text"
                    name="name"
                    required
                    placeholder="Max Mustermann"
                    class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-[#1CC5D9] focus:border-transparent text-slate-800 text-sm"
                  />
                </div>
                <div>
                  <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                    E-Mail Adresse *
                  </label>
                  <input
                    type="email"
                    name="email"
                    required
                    placeholder="max@unternehmen.de"
                    class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-[#1CC5D9] focus:border-transparent text-slate-800 text-sm"
                  />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                  <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                    Telefonnummer
                  </label>
                  <input
                    type="tel"
                    name="phone"
                    placeholder="+49 123 456789"
                    class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-[#1CC5D9] focus:border-transparent text-slate-800 text-sm"
                  />
                </div>
                <div>
                  <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                    Themenbereich
                  </label>
                  <select
                    name="topic"
                    id="topic-select"
                    class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-[#1CC5D9] focus:border-transparent text-slate-800 text-sm"
                  >
                    <option value="allgemein">Allgemeine Anfrage</option>
                    <option value="solarenergie">☀️ Solarenergie & PV-Anlagen</option>
                    <option value="kritis">🛡️ Kritische Infrastrukturen & BSI</option>
                    <option value="smart-city">🏙️ Smart City & LoRaWAN</option>
                    <option value="sharegy">⚡ Sharegy Plattform</option>
                    <option value="factofy">📊 Factofy Analytics</option>
                  </select>
                </div>
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                  Ihre Nachricht *
                </label>
                <textarea
                  name="message"
                  rows="5"
                  required
                  placeholder="Wie können wir Ihnen weiterhelfen?"
                  class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-[#1CC5D9] focus:border-transparent text-slate-800 text-sm"
                ></textarea>
              </div>

              <div class="flex items-start gap-3">
                <input
                  type="checkbox"
                  required
                  id="privacy"
                  class="mt-1 rounded text-[#1CC5D9] focus:ring-[#1CC5D9]"
                />
                <label for="privacy" class="text-xs text-slate-500 leading-normal">
                  Ich habe die <a href="/datenschutz" class="text-[#1CC5D9] underline">Datenschutzerklärung</a> zur Kenntnis genommen und stimme der Verarbeitung meiner Daten zu.
                </label>
              </div>

              <button
                type="submit"
                class="w-full py-4 rounded-xl bg-[#1CC5D9] text-[#062F32] font-bold text-base hover:bg-[#17AEC0] hover:shadow-lg transition-all"
              >
                Nachricht absenden
              </button>
            </form>
          </div>
        </div>

      </div>
    </div>
  </section>
</Layout>

<script>
  // Preselect topic from URL param if available
  const urlParams = new URLSearchParams(window.location.search);
  const anliegen = urlParams.get('anliegen');
  if (anliegen) {
    const select = document.getElementById('topic-select') as HTMLSelectElement;
    if (select) {
      if (anliegen === 'kritis') select.value = 'kritis';
      if (anliegen === 'smart-city') select.value = 'smart-city';
      if (anliegen === 'solar') select.value = 'solarenergie';
    }
  }
</script>
