---
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.replace(/\/$/, "") || "/";

const navLinks = [
  { name: "Home", href: "/" },
  { name: "☀️ Solarenergie & PV", href: "/solarenergie", highlight: true },
  { name: "⚡ Sharegy", href: "https://sharegy.de", external: true },
  { name: "📊 Factofy", href: "https://factofy.io", external: true },
  { name: "Kritische Infrastrukturen", href: "/dienstleistungen/kritische-infrastrukturen" },
  { name: "Smart City", href: "/dienstleistungen/smart-city" },
  { name: "Über Uns", href: "/ueber-uns" },
  { name: "Kontakt", href: "/kontakt" },
];
---

<header class="sticky top-0 z-50 bg-[#062F32]/95 backdrop-blur-md border-b border-white/10 text-white transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-2.5 group">
        <div class="w-10 h-10 rounded-xl bg-[#1CC5D9] flex items-center justify-center font-black text-[#062F32] text-xl shadow-md group-hover:scale-105 transition-transform">
          ⚡
        </div>
        <div class="flex flex-col">
          <span class="font-bold text-2xl tracking-tight text-white font-['Poppins']">
            smart<span class="text-[#1CC5D9]">Evo</span>
          </span>
          <span class="text-[10px] uppercase tracking-widest text-slate-300 font-medium">
            Business re-defined
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden xl:flex items-center gap-1.5">
        {navLinks.map((item) => {
          const isActive = !item.external && currentPath === item.href.replace(/\/$/, "");
          return (
            <a
              href={item.href}
              target={item.external ? "_blank" : "_self"}
              rel={item.external ? "noopener noreferrer" : ""}
              class={`px-3 py-2 rounded-lg text-sm font-medium transition-all ${
                isActive
                  ? "text-[#1CC5D9] bg-white/10 font-semibold"
                  : item.highlight
                  ? "text-amber-300 hover:text-amber-200 bg-amber-500/10 border border-amber-400/30"
                  : "text-slate-200 hover:text-white hover:bg-white/5"
              }`}
            >
              {item.name}
              {item.external && <span class="text-[10px] ml-1 opacity-70">↗</span>}
            </a>
          );
        })}
      </nav>

      <!-- CTA Button Desktop -->
      <div class="hidden md:flex items-center gap-3">
        <a
          href="/solarenergie#anfrage"
          class="px-5 py-2.5 rounded-xl bg-[#1CC5D9] text-[#062F32] font-bold text-sm hover:bg-[#17AEC0] hover:shadow-lg transition-all flex items-center gap-2"
        >
          <span>☀️ PV-Angebot anfordern</span>
        </a>
      </div>

      <!-- Mobile Menu Toggle Button -->
      <div class="flex xl:hidden">
        <button
          type="button"
          id="mobile-menu-btn"
          class="p-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-white focus:outline-none transition-colors"
          aria-label="Menü öffnen"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden xl:hidden bg-[#042022] border-b border-white/10 px-4 pt-2 pb-6 space-y-1">
    {navLinks.map((item) => (
      <a
        href={item.href}
        target={item.external ? "_blank" : "_self"}
        class="block px-4 py-2.5 rounded-lg text-base font-medium text-slate-200 hover:text-white hover:bg-white/10 transition-colors"
      >
        {item.name}
      </a>
    ))}
    <div class="pt-4">
      <a
        href="/solarenergie#anfrage"
        class="block w-full text-center px-5 py-3 rounded-xl bg-[#1CC5D9] text-[#062F32] font-bold text-sm hover:bg-[#17AEC0] transition-colors"
      >
        ☀️ Jetzt PV-Angebot anfordern
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
