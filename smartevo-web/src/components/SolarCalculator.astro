---
// SolarCalculator.astro - Interaktiver Solarertrags- & Einsparrechner
---

<div class="bg-[#062F32] rounded-3xl p-6 md:p-10 border border-[#1CC5D9]/30 text-white shadow-2xl relative overflow-hidden" id="pv-rechner">
  <!-- Decorative Glow Backdrops -->
  <div class="absolute -top-24 -right-24 w-72 h-72 bg-[#1CC5D9]/20 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-24 -left-24 w-72 h-72 bg-emerald-500/15 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative z-10">
    <div class="text-center max-w-2xl mx-auto mb-8">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-[#1CC5D9]/20 text-[#1CC5D9] border border-[#1CC5D9]/40 mb-3">
        ☀️ Interaktiver Solar-Rechner
      </span>
      <h3 class="text-2xl sm:text-3xl font-bold font-['Poppins']">
        Berechnen Sie Ihr persönliches <span class="text-[#1CC5D9]">Solar-Einsparpotenzial</span>
      </h3>
      <p class="text-sm text-slate-300 mt-2">
        Finden Sie in 30 Sekunden heraus, wie viel Stromkosten Sie mit einer smartEvo PV-Anlage & Speicher sparen.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <!-- Inputs Column -->
      <div class="lg:col-span-7 space-y-6 bg-white/5 p-6 rounded-2xl border border-white/10">
        
        <!-- Slider 1: Dachfläche / Modulanzahl -->
        <div>
          <div class="flex justify-between items-center text-sm font-semibold mb-2">
            <span>Verfügbare Dachfläche:</span>
            <span class="text-[#1CC5D9] text-base font-bold font-mono" id="val-roof">60 m² (ca. 10 kWp)</span>
          </div>
          <input
            type="range"
            id="slider-roof"
            min="20"
            max="200"
            step="5"
            value="60"
            class="w-full h-2 bg-slate-700 rounded-lg appearance-none cursor-pointer accent-[#1CC5D9]"
          />
          <div class="flex justify-between text-[11px] text-slate-400 mt-1">
            <span>20 m² (Reihenhaus)</span>
            <span>100 m² (Einfamilienhaus)</span>
            <span>200 m² (Gewerbe)</span>
          </div>
        </div>

        <!-- Slider 2: Stromverbrauch -->
        <div>
          <div class="flex justify-between items-center text-sm font-semibold mb-2">
            <span>Jährlicher Stromverbrauch:</span>
            <span class="text-[#1CC5D9] text-base font-bold font-mono" id="val-consumption">4.500 kWh / Jahr</span>
          </div>
          <input
            type="range"
            id="slider-consumption"
            min="1500"
            max="15000"
            step="250"
            value="4500"
            class="w-full h-2 bg-slate-700 rounded-lg appearance-none cursor-pointer accent-[#1CC5D9]"
          />
          <div class="flex justify-between text-[11px] text-slate-400 mt-1">
            <span>1.500 kWh (Single)</span>
            <span>4.500 kWh (Familie)</span>
            <span>15.000 kWh (Wärmepumpe & E-Auto)</span>
          </div>
        </div>

        <!-- Checkbox / Toggle: Batteriespeicher -->
        <div class="pt-2 border-t border-white/10 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <input
              type="checkbox"
              id="check-battery"
              checked
              class="w-5 h-5 rounded text-[#1CC5D9] focus:ring-[#1CC5D9] bg-slate-800 border-white/20 cursor-pointer"
            />
            <div>
              <label for="check-battery" class="text-sm font-bold cursor-pointer">
                Inklusive Batteriespeicher & Sharegy HEMS
              </label>
              <div class="text-xs text-slate-400">
                Erhöht den Autarkiegrad von ca. 35 % auf bis zu 85 %
              </div>
            </div>
          </div>
          <span class="text-xs font-semibold px-2 py-1 rounded bg-[#1CC5D9]/20 text-[#1CC5D9] border border-[#1CC5D9]/30">
            Empfohlen
          </span>
        </div>

      </div>

      <!-- Results Display Column -->
      <div class="lg:col-span-5 bg-gradient-to-br from-[#042022] to-[#062F32] p-6 sm:p-8 rounded-2xl border border-[#1CC5D9]/40 text-center shadow-xl space-y-6">
        
        <!-- Primary Result: Annual Savings -->
        <div>
          <div class="text-xs uppercase font-bold tracking-wider text-slate-300 mb-1">
            Ihre geschätzte Ersparnis
          </div>
          <div class="text-4xl sm:text-5xl font-black text-[#1CC5D9] font-['Poppins']" id="res-savings">
            1.850 €
          </div>
          <div class="text-xs text-slate-400 mt-1">
            pro Jahr (Strompreis-Berechnung: ca. 0,38 €/kWh)
          </div>
        </div>

        <!-- 3-KPI Grid -->
        <div class="grid grid-cols-2 gap-3 pt-4 border-t border-white/10 text-left">
          <div class="bg-white/5 p-3 rounded-xl border border-white/10">
            <div class="text-[11px] text-slate-400 font-medium">Autarkiegrad</div>
            <div class="text-xl font-bold text-white font-mono" id="res-autarky">ca. 82 %</div>
          </div>
          <div class="bg-white/5 p-3 rounded-xl border border-white/10">
            <div class="text-[11px] text-slate-400 font-medium">Empf. Anlagengröße</div>
            <div class="text-xl font-bold text-white font-mono" id="res-kwp">10,0 kWp</div>
          </div>
          <div class="bg-white/5 p-3 rounded-xl border border-white/10">
            <div class="text-[11px] text-slate-400 font-medium">Empf. Speicher</div>
            <div class="text-xl font-bold text-white font-mono" id="res-battery">9,6 kWh</div>
          </div>
          <div class="bg-white/5 p-3 rounded-xl border border-white/10">
            <div class="text-[11px] text-slate-400 font-medium">CO₂-Einsparung</div>
            <div class="text-xl font-bold text-emerald-400 font-mono" id="res-co2">4,8 t / Jahr</div>
          </div>
        </div>

        <!-- CTA Button to Lead Form -->
        <div class="pt-2">
          <a
            href="/solarenergie#anfrage"
            class="block w-full py-3.5 px-6 rounded-xl bg-[#1CC5D9] text-[#062F32] font-black text-sm hover:bg-[#17AEC0] shadow-lg hover:shadow-cyan-500/30 transition-all font-['Poppins'] tracking-wide uppercase"
          >
            ☀️ Unverbindliches Angebot anfordern
          </a>
        </div>

      </div>

    </div>
  </div>
</div>

<script>
  function setupCalculator() {
    const sliderRoof = document.getElementById('slider-roof');
    const sliderConsumption = document.getElementById('slider-consumption');
    const checkBattery = document.getElementById('check-battery');

    const valRoof = document.getElementById('val-roof');
    const valConsumption = document.getElementById('val-consumption');

    const resSavings = document.getElementById('res-savings');
    const resAutarky = document.getElementById('res-autarky');
    const resKwp = document.getElementById('res-kwp');
    const resBattery = document.getElementById('res-battery');
    const resCo2 = document.getElementById('res-co2');

    if (!sliderRoof || !sliderConsumption) return;

    function calculate() {
      const roof = parseFloat(sliderRoof.value);
      const consumption = parseFloat(sliderConsumption.value);
      const hasBattery = checkBattery.checked;

      // 6 m² pro kWp
      const kwp = Math.min(Math.round((roof / 6.0) * 10) / 10, 30.0);
      const annualSolarYield = kwp * 950; // kWh/Jahr in Deutschland

      valRoof.textContent = `${roof} m² (ca. ${kwp.toFixed(1)} kWp)`;
      valConsumption.textContent = `${consumption.toLocaleString('de-DE')} kWh / Jahr`;

      let autarkyPercent = hasBattery ? 80 : 35;
      if (kwp < (consumption / 1000) * 0.7) {
        autarkyPercent -= 15;
      }
      autarkyPercent = Math.min(Math.max(autarkyPercent, 25), 88);

      const batterySize = hasBattery ? Math.round(kwp * 0.95 * 10) / 10 : 0;
      const selfConsumedKwh = Math.min(consumption * (autarkyPercent / 100), annualSolarYield * 0.75);
      const gridFeedinKwh = Math.max(0, annualSolarYield - selfConsumedKwh);

      // Strompreis 0,38 €/kWh Bezug, Einspeisung 0,08 €/kWh
      const savingsDirect = selfConsumedKwh * 0.38;
      const feedinRevenue = gridFeedinKwh * 0.081;
      const totalSavings = Math.round(savingsDirect + feedinRevenue);

      const co2Tons = (annualSolarYield * 0.485 / 1000).toFixed(1);

      resSavings.textContent = `${totalSavings.toLocaleString('de-DE')} €`;
      resAutarky.textContent = `ca. ${autarkyPercent} %`;
      resKwp.textContent = `${kwp.toFixed(1)} kWp`;
      resBattery.textContent = hasBattery ? `${batterySize.toFixed(1)} kWh` : 'Ohne Speicher';
      resCo2.textContent = `${co2Tons} t / Jahr`;
    }

    sliderRoof.addEventListener('input', calculate);
    sliderConsumption.addEventListener('input', calculate);
    checkBattery.addEventListener('change', calculate);

    calculate();
  }

  // Run on page load
  setupCalculator();
</script>
