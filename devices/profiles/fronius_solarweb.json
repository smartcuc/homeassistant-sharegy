{
  "id": "fronius_solarweb",
  "name": "Fronius Solar.web",
  "vendor": "Fronius",
  "category": "inverter_hybrid",
  "protocol": "http_cloud",
  "description": "Direkte Anbindung für Fronius GEN24 Plus, Symo, Primo und Tauro über Solar.web oder lokale Solar API.",
  "help": {
    "de": "1. Gib deine gewohnten Solar.web Zugangsdaten (E-Mail und Passwort) ein.\n2. Deine PV-Anlage wird automatisch erkannt.\n3. Alternativ: Gib die lokale IP-Adresse deines Fronius Wechselrichters ein, um die Daten direkt im Heimnetzwerk abzurufen (oder nutze die Sharegy Home Assistant / ioBroker Integration).",
    "en": "1. Enter your standard Solar.web credentials (Email and Password).\n2. Your PV system is automatically discovered.\n3. Alternatively: Enter the local IP address of your Fronius inverter to query it directly on your local network (or use the Sharegy Home Assistant / ioBroker integration)."
  },
  "connection": {
    "auth_type": "basic_or_token",
    "default_base_url": "https://swqapi.solarweb.com",
    "polling_interval_seconds": 60,
    "fields": [
      {
        "key": "username",
        "label": "Solar.web E-Mail / Benutzername",
        "type": "string",
        "required": true,
        "placeholder": "name@beispiel.de"
      },
      {
        "key": "password",
        "label": "Solar.web Passwort",
        "type": "password",
        "required": true
      },
      {
        "key": "host",
        "label": "Lokale IP-Adresse / Host (Optional für Direkt-LAN)",
        "type": "string",
        "required": false,
        "placeholder": "z. B. 192.168.1.150"
      },
      {
        "key": "pv_system_id",
        "label": "PV-System ID (Optional, wird sonst autom. ermittelt)",
        "type": "string",
        "required": false,
        "placeholder": "01234567-89ab-cdef-0123-456789abcdef"
      }
    ]
  },
  "requests": {
    "telemetry": {
      "method": "GET",
      "endpoint": "/pvsystems/{{pv_system_id}}/flowdata"
    }
  },
  "metrics_mapping": {
    "pv_power_w": {
      "jsonpath": "$.data.channels[?(@.channelName=='PowerPV')].value",
      "scale": 1.0,
      "type": "float",
      "fallback": 0.0
    },
    "grid_power_w": {
      "jsonpath": "$.data.channels[?(@.channelName=='PowerGrid')].value",
      "scale": 1.0,
      "type": "float",
      "fallback": 0.0
    },
    "load_power_w": {
      "jsonpath": "$.data.channels[?(@.channelName=='PowerLoad')].value",
      "scale": 1.0,
      "type": "float",
      "fallback": 0.0
    },
    "battery_power_w": {
      "jsonpath": "$.data.channels[?(@.channelName=='PowerAkku')].value",
      "scale": 1.0,
      "type": "float",
      "fallback": 0.0
    },
    "battery_soc": {
      "jsonpath": "$.data.channels[?(@.channelName=='StateOfCharge_Akku')].value",
      "scale": 1.0,
      "type": "float",
      "unit": "%",
      "fallback": null
    }
  }
}
