{
  "id": "solaredge_cloud",
  "name": "SolarEdge Monitoring API",
  "vendor": "SolarEdge",
  "category": "inverter_hybrid",
  "protocol": "http_cloud",
  "description": "Cloud-Schnittstelle für alle SolarEdge Wechselrichter via SolarEdge Monitoring Portal API.",
  "connection": {
    "auth_type": "api_key_query",
    "default_base_url": "https://monitoringapi.solaredge.com",
    "polling_interval_seconds": 60,
    "fields": [
      {
        "key": "site_id",
        "label": "SolarEdge Anlagen-ID (Site ID)",
        "type": "string",
        "required": true,
        "description": "Deine Site ID aus dem SolarEdge Portal",
        "placeholder": "z. B. 123456"
      },
      {
        "key": "api_key",
        "label": "SolarEdge API-Key",
        "type": "password",
        "required": true,
        "description": "Generierter API-Key aus den SolarEdge Admin-Einstellungen",
        "placeholder": "32-stelliger Hex-Key"
      }
    ]
  },
  "requests": {
    "telemetry": {
      "method": "GET",
      "endpoint": "/site/{{site_id}}/currentPowerFlow.json",
      "params": {
        "api_key": "{{api_key}}"
      }
    }
  },
  "metrics_mapping": {
    "pv_power_w": {
      "jsonpath": "$.siteCurrentPowerFlow.PV.currentPower",
      "scale": 1000.0,
      "type": "float",
      "fallback": 0.0
    },
    "grid_power_w": {
      "jsonpath": "$.siteCurrentPowerFlow.GRID.currentPower",
      "scale": 1000.0,
      "type": "float",
      "fallback": 0.0
    },
    "load_power_w": {
      "jsonpath": "$.siteCurrentPowerFlow.LOAD.currentPower",
      "scale": 1000.0,
      "type": "float",
      "fallback": 0.0
    },
    "battery_power_w": {
      "jsonpath": "$.siteCurrentPowerFlow.STORAGE.currentPower",
      "scale": 1000.0,
      "type": "float",
      "fallback": 0.0
    },
    "battery_soc": {
      "jsonpath": "$.siteCurrentPowerFlow.STORAGE.chargeLevel",
      "scale": 1.0,
      "type": "float",
      "unit": "%",
      "fallback": null
    }
  }
}
